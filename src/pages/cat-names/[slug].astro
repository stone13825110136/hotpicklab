---
import NameLongtailPage from '../../components/naming/NameLongtailPage.astro';
import { CAT_SEO_PAGES } from '../../lib/naming/seo-pages';

export function getStaticPaths() {
  return CAT_SEO_PAGES.map((page) => ({
    params: { slug: page.slug },
    props: { page },
  }));
}

const { page } = Astro.props;
---

<NameLongtailPage page={page} />
