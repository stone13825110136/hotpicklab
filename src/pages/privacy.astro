---
import Layout from '../layouts/Layout.astro';
import { SITE } from '../lib/site';
---

<Layout
  title="Privacy Policy for HotPick Lab Pet Naming Tools"
  description="Privacy policy for HotPick Lab free pet name generator and dog/cat naming tools — what we collect and how we use it."
>
  <article class="legal shell">
    <h1>Privacy Policy</h1>
    <p class="updated">Last updated: July 26, 2026</p>
    <p>
      {SITE.name} ("we") operates {SITE.url}. Naming Lab tools (including Pet Name Lab) run in your
      browser. Name filters and Fortune Draw results are generated locally from our published name
      lists — we do not require an account.
    </p>
    <h2>What we collect</h2>
    <p>
      If you email us, we collect the contact details and message you send. We use that only to
      reply. We do not sell personal information.
    </p>
    <h2>Ads & analytics</h2>
    <p>
      We may show advertising (for example AdSense) and use privacy-respecting analytics for
      aggregate traffic. Ads do not block naming or Fortune Draw.
    </p>
    <h2>Contact</h2>
    <p>
      Email: <a href={`mailto:${SITE.contactEmail}`}>{SITE.contactEmail}</a>
    </p>
  </article>
</Layout>

<style>
  .legal {
    padding: 3rem 0 4rem;
    max-width: 40rem;
  }

  .legal h1 {
    margin: 0 0 0.5rem;
    font-family: 'Space Grotesk', system-ui, sans-serif;
    font-size: clamp(1.8rem, 3vw, 2.4rem);
    letter-spacing: -0.02em;
  }

  .updated {
    color: var(--muted);
    font-size: 0.8rem;
  }

  .legal h2 {
    margin: 2rem 0 0.5rem;
    font-family: 'Space Grotesk', system-ui, sans-serif;
    font-size: 1.25rem;
  }
</style>
