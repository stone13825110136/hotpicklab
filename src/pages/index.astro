---
import Layout from '../layouts/Layout.astro';
import { SITE } from '../lib/site';
---

<Layout
  title="Dog & Cat Name Lab — Compare Names & Get a Hot Pick"
  description={SITE.description}
  keywords={[
    'pet name generator',
    'dog names',
    'cat names',
    'pet name picker',
    'best dog names',
    'hot pick',
  ]}
>
  <section class="hero">
    <div class="shell hero-grid">
      <div class="hero-copy">
        <p class="brand-mark" translate="no">{SITE.name}</p>
        <h1>Pick a pet name you’ll actually use</h1>
        <p class="lede">
          Shortlist dog or cat names, compare a few favorites, and land on one
          <strong>Hot Pick</strong> — not a wall of random suggestions.
        </p>
        <div class="cta-row">
          <a class="cta" href="/tools/pet-name-lab">Open Pet Name Lab</a>
          <a class="cta cta-secondary" href="/dog-names">Dog name lists</a>
          <a class="cta cta-secondary" href="/cat-names">Cat name lists</a>
          <p class="cta-note">Free · No sign-up · Optional fun vibe cards (entertainment only)</p>
        </div>
      </div>

      <aside class="flow-sheet" aria-label="How it works">
        <ol>
          <li><span>1</span> Choose dog or cat, gender, and vibe</li>
          <li><span>2</span> Shortlist practical-scored names</li>
          <li><span>3</span> Compare 2–5 favorites</li>
          <li><span>4</span> Get one Hot Pick</li>
        </ol>
      </aside>
    </div>
  </section>

  <section class="shell path" id="labs">
    <h2>Naming labs</h2>
    <div class="path-grid">
      <article>
        <p class="tag">Available now</p>
        <h3>Pet Name Lab</h3>
        <p>Dog and cat names with scores, compare, and one Hot Pick.</p>
        <a href="/tools/pet-name-lab">Try it →</a>
      </article>
      <article>
        <p class="tag">Available now</p>
        <h3>Dog name lists</h3>
        <p>Cute, strong, unique, classic — plus boy and girl shortlists.</p>
        <a href="/dog-names">Browse dog names →</a>
      </article>
      <article>
        <p class="tag">Available now</p>
        <h3>Cat name lists</h3>
        <p>Cute, strong, unique, classic — plus boy and girl shortlists.</p>
        <a href="/cat-names">Browse cat names →</a>
      </article>
    </div>
  </section>
</Layout>

<style>
  .hero {
    padding: 2.75rem 0 2rem;
  }

  .hero-grid {
    display: grid;
    gap: 1.75rem;
    align-items: center;
  }

  @media (min-width: 860px) {
    .hero-grid {
      grid-template-columns: 1.15fr 0.85fr;
    }
  }

  .brand-mark {
    font-family: 'Space Grotesk', system-ui, sans-serif;
    font-weight: 700;
    font-size: clamp(1.45rem, 3vw, 1.85rem);
    margin: 0 0 0.85rem;
    color: var(--signal);
  }

  h1 {
    margin: 0 0 0.75rem;
    font-family: 'Space Grotesk', system-ui, sans-serif;
    font-size: clamp(1.85rem, 4.5vw, 2.75rem);
    line-height: 1.12;
    letter-spacing: -0.02em;
  }

  .lede {
    margin: 0 0 1.25rem;
    color: var(--ink-soft);
    font-size: 1.05rem;
    max-width: 34rem;
  }

  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    align-items: center;
  }

  .cta {
    display: inline-block;
    padding: 0.7rem 1.05rem;
    border-radius: 999px;
    background: var(--signal);
    color: #fff;
    font-weight: 650;
    text-decoration: none;
  }

  .cta:hover {
    background: var(--signal-bright);
    text-decoration: none;
  }

  .cta-secondary {
    background: transparent;
    color: var(--ink);
    border: 1px solid var(--line);
  }

  .cta-secondary:hover {
    border-color: var(--signal);
    background: transparent;
  }

  .cta-note {
    flex-basis: 100%;
    margin: 0.25rem 0 0;
    color: var(--muted);
    font-size: 0.9rem;
  }

  .flow-sheet {
    background: var(--panel-dark);
    color: #e8eef8;
    border-radius: 16px;
    padding: 1.25rem 1.35rem;
  }

  .flow-sheet ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.75rem;
  }

  .flow-sheet li {
    display: flex;
    gap: 0.7rem;
    align-items: center;
    font-size: 0.95rem;
  }

  .flow-sheet span {
    display: inline-grid;
    place-items: center;
    width: 1.55rem;
    height: 1.55rem;
    border-radius: 999px;
    background: var(--signal);
    color: #fff;
    font-weight: 700;
    font-size: 0.8rem;
    flex-shrink: 0;
  }

  .path {
    padding: 0.5rem 0 3.5rem;
  }

  .path h2 {
    font-family: 'Space Grotesk', system-ui, sans-serif;
    margin: 0 0 1rem;
  }

  .path-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 0.9rem;
  }

  .path-grid article {
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 1.05rem 1.1rem;
  }

  .tag {
    margin: 0 0 0.3rem;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--signal);
  }

  .path-grid h3 {
    margin: 0 0 0.4rem;
    font-size: 1.05rem;
  }

  .path-grid p {
    margin: 0 0 0.7rem;
    color: var(--muted);
    font-size: 0.92rem;
  }

  .path-grid a {
    font-weight: 650;
    color: var(--signal);
  }
</style>
