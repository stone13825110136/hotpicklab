---
import Layout from '../../layouts/Layout.astro';
import { SITE } from '../../lib/site';

const labs = [
  {
    href: '/tools/pet-name-lab',
    title: 'Pet Name Lab',
    status: 'Available now',
    blurb: 'Dog and cat names with practical scores, compare, and one Hot Pick.',
  },
  {
    href: '/dog-names',
    title: 'Dog name lists',
    status: 'Available now',
    blurb: 'Cute, strong, unique, classic dog names — plus boy and girl shortlists.',
  },
  {
    href: '/cat-names',
    title: 'Cat name lists',
    status: 'Available now',
    blurb: 'Cute, strong, unique, classic cat names — plus boy and girl shortlists.',
  },
];
---

<Layout
  title="Free Naming Labs — Pet Name Generator, Dog & Cat Name Lists"
  description="Free naming labs from HotPick Lab. Start with Pet Name Lab: generate scored dog and cat names, compare shortlists, and get one Hot Pick."
  keywords={['naming lab', 'pet name lab', 'pet name generator', 'name picker', 'hot pick']}
>
  <section class="labs-hero">
    <div class="shell">
      <p class="brand-mark" translate="no">{SITE.name}</p>
      <h1>Naming Labs</h1>
      <p class="lede">Compare shortlists and pick one winner — pets first, then people and brands.</p>
    </div>
  </section>
  <section class="labs-grid shell">
    {
      labs.map((lab) => (
        <article class="lab-card">
          <p class="lab-status">{lab.status}</p>
          <h2>{lab.title}</h2>
          <p>{lab.blurb}</p>
          {lab.href !== '#' ? (
            <a class="cta" href={lab.href}>
              Open lab →
            </a>
          ) : (
            <span class="soon">Coming soon</span>
          )}
        </article>
      ))
    }
  </section>
</Layout>

<style>
  .labs-hero {
    padding: 2.5rem 0 1.5rem;
  }

  .brand-mark {
    font-family: 'Space Grotesk', system-ui, sans-serif;
    font-weight: 700;
    font-size: 1.35rem;
    margin: 0 0 0.75rem;
    color: var(--signal);
  }

  .labs-hero h1 {
    margin: 0 0 0.5rem;
    font-family: 'Space Grotesk', system-ui, sans-serif;
    font-size: clamp(1.8rem, 4vw, 2.4rem);
  }

  .lede {
    margin: 0;
    color: var(--muted);
    max-width: 36rem;
  }

  .labs-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1rem;
    padding-bottom: 3rem;
  }

  .lab-card {
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 1.15rem 1.2rem;
  }

  .lab-status {
    margin: 0 0 0.35rem;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--signal);
  }

  .lab-card h2 {
    margin: 0 0 0.45rem;
    font-size: 1.15rem;
  }

  .lab-card p {
    margin: 0 0 0.9rem;
    color: var(--muted);
    font-size: 0.95rem;
  }

  .cta {
    font-weight: 650;
    color: var(--signal);
  }

  .soon {
    color: var(--muted);
    font-size: 0.9rem;
  }
</style>
