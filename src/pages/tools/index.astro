---
import Layout from '../../layouts/Layout.astro';
import { SITE } from '../../lib/site';

const labs = [
  {
    href: '/tools/pet-name-lab',
    title: 'Pet Name Lab',
    status: 'Start here',
    blurb: 'Score names, compare favorites, set Your pick, and make a free name card.',
    hot: true,
  },
  {
    href: '/dog-names',
    title: 'Dog name lists',
    status: 'Browse',
    blurb: 'Cute, strong, unique, classic dog names — plus boy and girl shortlists.',
    hot: false,
  },
  {
    href: '/cat-names',
    title: 'Cat name lists',
    status: 'Browse',
    blurb: 'Cute, strong, unique, classic cat names — plus boy and girl shortlists.',
    hot: false,
  },
];
---

<Layout
  title="Free Naming Labs — Pet Name Generator, Dog & Cat Name Lists"
  description="Free naming labs from HotPick Lab. Start with Pet Name Lab: generate scored dog and cat names, compare shortlists, and get one Hot Pick."
  keywords={['naming lab', 'pet name lab', 'pet name generator', 'name picker', 'hot pick']}
>
  <section class="labs-hero">
    <div class="labs-atmosphere" aria-hidden="true"></div>
    <div class="shell">
      <p class="brand-mark" translate="no">{SITE.name}</p>
      <h1>Naming Labs</h1>
      <p class="lede">
        Free tools to shortlist dog and cat names, compare favorites, and land on a name you’ll
        actually use.
      </p>
      <a class="hero-cta" href="/tools/pet-name-lab">Open Pet Name Lab</a>
    </div>
  </section>
  <section class="labs-grid shell">
    {
      labs.map((lab) => (
        <a class:list={['lab-card', lab.hot && 'lab-card-hot']} href={lab.href}>
          <p class="lab-status">{lab.status}</p>
          <h2>{lab.title}</h2>
          <p>{lab.blurb}</p>
          <span class="cta">Open →</span>
        </a>
      ))
    }
  </section>
</Layout>

<style>
  .labs-hero {
    position: relative;
    overflow: hidden;
    padding: 2.75rem 0 2rem;
    isolation: isolate;
  }

  .labs-atmosphere {
    position: absolute;
    inset: -20% -10% auto;
    height: 140%;
    z-index: -1;
    background:
      radial-gradient(ellipse 60% 50% at 20% 30%, rgba(26, 163, 143, 0.22), transparent 60%),
      radial-gradient(ellipse 50% 45% at 90% 0%, rgba(255, 107, 53, 0.16), transparent 55%),
      linear-gradient(165deg, #eaf5f2, #f6f7f9 55%, #f4ece6);
  }

  .brand-mark {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.5rem, 3vw, 1.9rem);
    margin: 0 0 0.65rem;
    color: var(--signal);
  }

  .labs-hero h1 {
    margin: 0 0 0.55rem;
    font-family: var(--font-display);
    font-size: clamp(2rem, 4.5vw, 2.7rem);
    letter-spacing: -0.03em;
  }

  .lede {
    margin: 0 0 1.15rem;
    color: var(--ink-soft);
    max-width: 36rem;
    font-size: 1.05rem;
  }

  .hero-cta {
    display: inline-block;
    padding: 0.72rem 1.15rem;
    border-radius: 999px;
    background: #ff6b35;
    color: #fff;
    font-weight: 700;
    text-decoration: none;
    box-shadow: 0 10px 24px rgba(255, 107, 53, 0.25);
  }

  .hero-cta:hover {
    color: #fff;
    text-decoration: none;
    background: #ff814f;
  }

  .labs-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1rem;
    padding-bottom: 3.25rem;
  }

  .lab-card {
    display: block;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 16px;
    padding: 1.2rem 1.2rem 1.25rem;
    text-decoration: none;
    color: inherit;
    transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
  }

  .lab-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 14px 28px rgba(18, 21, 26, 0.08);
    text-decoration: none;
    color: inherit;
    border-color: rgba(13, 110, 98, 0.4);
  }

  .lab-card-hot {
    border-color: rgba(255, 107, 53, 0.4);
    background: linear-gradient(160deg, #fff, #fff6f1);
  }

  .lab-status {
    margin: 0 0 0.35rem;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--signal);
  }

  .lab-card-hot .lab-status {
    color: #ff6b35;
  }

  .lab-card h2 {
    margin: 0 0 0.45rem;
    font-family: var(--font-display);
    font-size: 1.2rem;
  }

  .lab-card p {
    margin: 0 0 0.9rem;
    color: var(--muted);
    font-size: 0.95rem;
  }

  .cta {
    font-weight: 700;
    color: var(--signal);
  }

  .lab-card-hot .cta {
    color: #ff6b35;
  }
</style>
