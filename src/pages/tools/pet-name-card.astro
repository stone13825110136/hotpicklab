---
import ToolLayout from '../../layouts/ToolLayout.astro';
import dogNames from '../../data/naming/dog-names.json';
import catNames from '../../data/naming/cat-names.json';
import catNamesExtra from '../../data/naming/cat-names-extra.json';
import { rankNames } from '../../lib/naming/generate';
import type { Gender, NameEntry, Species, Vibe } from '../../lib/naming/types';

function mergePool(base: NameEntry[], extra: NameEntry[]): NameEntry[] {
  const map = new Map<string, NameEntry>();
  for (const n of base) map.set(n.name.toLowerCase(), n);
  for (const n of extra) {
    const key = n.name.toLowerCase();
    if (!map.has(key)) map.set(key, n);
  }
  return [...map.values()];
}

const dogPool = dogNames as NameEntry[];
const catPool = mergePool(catNames as NameEntry[], catNamesExtra as NameEntry[]);

function topNames(pool: NameEntry[], gender: Gender, vibe: Vibe, n = 48) {
  return rankNames(pool, gender, vibe).slice(0, n).map((x) => ({
    name: x.name,
    vibe: x.vibes[0] || vibe,
  }));
}

const payload = {
  lists: {
    dog: {
      cute: topNames(dogPool, 'neutral', 'cute'),
      strong: topNames(dogPool, 'neutral', 'strong'),
      unique: topNames(dogPool, 'neutral', 'unique'),
      classic: topNames(dogPool, 'neutral', 'classic'),
      boy: topNames(dogPool, 'boy', 'classic'),
      girl: topNames(dogPool, 'girl', 'classic'),
    },
    cat: {
      cute: topNames(catPool, 'neutral', 'cute'),
      strong: topNames(catPool, 'neutral', 'strong'),
      unique: topNames(catPool, 'neutral', 'unique'),
      classic: topNames(catPool, 'neutral', 'classic'),
      boy: topNames(catPool, 'boy', 'classic'),
      girl: topNames(catPool, 'girl', 'classic'),
    },
  },
};
---

<ToolLayout
  title="Pet Name Card (local test)"
  description="Local draft: pick a name, optional pet photo, download a free Identity Card. Browser-only — no upload, no payment."
  backHref="/tools/pet-name-lab"
  backLabel="Pet Name Lab"
  noindex={true}
>
  <div id="pnc" class="pnc">
    <script id="pnc-data" type="application/json" set:html={JSON.stringify(payload)} />
    <p class="pnc-badge">LOCAL TEST · free · photo stays on your device · noindex</p>
    <h1 class="pnc-h1">Make a name card</h1>
    <p class="pnc-lead" id="pnc-lead">
      Optionally add a pet photo, then download your name card. Nothing is uploaded. No payment.
    </p>

    <section class="pnc-panel" id="pnc-locked" hidden>
      <h2 class="pnc-h2">Your pick</h2>
      <p class="pnc-locked-name" id="pnc-locked-name">—</p>
      <p class="pnc-note">Brought from Pet Name Lab — no need to pick again.</p>
      <button type="button" class="pnc-btn-ghost" id="pnc-change-name">Change name</button>
    </section>

    <section class="pnc-panel" id="pnc-picker">
      <h2 class="pnc-h2" id="pnc-pick-title">1. Pick a name</h2>
      <div class="pnc-row">
        <label class="pnc-field">
          <span>Species</span>
          <select id="pnc-species">
            <option value="dog">Dog</option>
            <option value="cat">Cat</option>
          </select>
        </label>
        <label class="pnc-field">
          <span>List</span>
          <select id="pnc-list">
            <option value="cute">Cute</option>
            <option value="strong">Strong</option>
            <option value="unique">Unique</option>
            <option value="classic">Classic</option>
            <option value="boy">Boy</option>
            <option value="girl">Girl</option>
          </select>
        </label>
      </div>
      <label class="pnc-field">
        <span>Or type your own</span>
        <input id="pnc-custom" type="text" maxlength="24" placeholder="e.g. Daisy" autocomplete="off" />
      </label>
      <div class="pnc-names" id="pnc-names" role="listbox" aria-label="Name shortlist"></div>
      <p class="pnc-selected">Selected: <strong id="pnc-selected-label">—</strong></p>
    </section>

    <section class="pnc-panel">
      <h2 class="pnc-h2" id="pnc-photo-title">2. Photo (optional)</h2>
      <p class="pnc-note">Stays in this browser only. Drag inside the circle to center the face.</p>
      <input id="pnc-photo" type="file" accept="image/*" />
      <div id="pnc-crop" class="pnc-crop" hidden>
        <canvas id="pnc-crop-canvas" width="320" height="320" aria-label="Drag to center the pet face"></canvas>
        <p class="pnc-crop-hint">Drag to move · use zoom for a closer crop</p>
        <label class="pnc-zoom">
          <span>Zoom</span>
          <input id="pnc-zoom" type="range" min="1" max="3" step="0.05" value="1" />
        </label>
      </div>
      <button type="button" class="pnc-btn-ghost" id="pnc-clear-photo" hidden>Remove photo</button>
    </section>

    <section class="pnc-panel">
      <h2 class="pnc-h2" id="pnc-preview-title">3. Preview &amp; download</h2>
      <div class="pnc-preview-wrap">
        <canvas id="pnc-canvas" width="1080" height="1350" aria-label="Name identity card preview"></canvas>
      </div>
      <button type="button" class="btn pnc-btn" id="pnc-download" disabled>Download PNG</button>
    </section>
  </div>

  <script>
    import {
      drawNameIdentityCard,
      downloadCanvasPng,
      normalizePhotoCrop,
      type PhotoCrop,
    } from '../../lib/naming/name-card';
    import type { Species } from '../../lib/naming/types';

    type ListKey = 'cute' | 'strong' | 'unique' | 'classic' | 'boy' | 'girl';
    type NameHit = { name: string; vibe: string };

    const dataEl = document.getElementById('pnc-data');
    if (!dataEl?.textContent) throw new Error('pnc data missing');
    const payload = JSON.parse(dataEl.textContent) as {
      lists: Record<Species, Record<ListKey, NameHit[]>>;
    };

    const speciesEl = document.getElementById('pnc-species') as HTMLSelectElement;
    const listEl = document.getElementById('pnc-list') as HTMLSelectElement;
    const customEl = document.getElementById('pnc-custom') as HTMLInputElement;
    const namesEl = document.getElementById('pnc-names')!;
    const selectedLabel = document.getElementById('pnc-selected-label')!;
    const photoEl = document.getElementById('pnc-photo') as HTMLInputElement;
    const clearPhotoBtn = document.getElementById('pnc-clear-photo') as HTMLButtonElement;
    const cropWrap = document.getElementById('pnc-crop')!;
    const cropCanvas = document.getElementById('pnc-crop-canvas') as HTMLCanvasElement;
    const zoomEl = document.getElementById('pnc-zoom') as HTMLInputElement;
    const canvas = document.getElementById('pnc-canvas') as HTMLCanvasElement;
    const downloadBtn = document.getElementById('pnc-download') as HTMLButtonElement;

    let selectedName = '';
    let selectedMeta = '';
    let photoUrl: string | null = null;
    let photoImg: HTMLImageElement | null = null;
    let photoCrop: PhotoCrop = { focusX: 0.5, focusY: 0.38, zoom: 1 };
    let renderToken = 0;
    let drag: { x: number; y: number; focusX: number; focusY: number } | null = null;

    const CROP_R = 148;

    function currentList(): NameHit[] {
      const species = speciesEl.value as Species;
      const key = listEl.value as ListKey;
      return payload.lists[species]?.[key] || [];
    }

    function renderNameButtons() {
      const items = currentList();
      namesEl.innerHTML = '';
      for (const item of items) {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'pnc-name' + (item.name === selectedName ? ' is-on' : '');
        btn.textContent = item.name;
        btn.setAttribute('role', 'option');
        btn.addEventListener('click', () => {
          customEl.value = '';
          selectName(item.name, `${capitalize(listEl.value)} · ${speciesEl.value === 'dog' ? 'Dog' : 'Cat'}`);
        });
        namesEl.appendChild(btn);
      }
    }

    function capitalize(s: string) {
      return s.charAt(0).toUpperCase() + s.slice(1);
    }

    function selectName(name: string, meta: string) {
      selectedName = name.trim();
      selectedMeta = meta;
      selectedLabel.textContent = selectedName || '—';
      downloadBtn.disabled = !selectedName;
      renderNameButtons();
      void redraw();
    }

    function paintCropPreview() {
      if (!photoImg) return;
      const ctx = cropCanvas.getContext('2d');
      if (!ctx) return;
      const w = cropCanvas.width;
      const h = cropCanvas.height;
      const cx = w / 2;
      const cy = h / 2;
      const crop = normalizePhotoCrop(photoImg.width, photoImg.height, photoCrop, CROP_R);
      photoCrop = crop;
      zoomEl.value = String(crop.zoom);

      ctx.clearRect(0, 0, w, h);
      ctx.fillStyle = '#0a0e1a';
      ctx.fillRect(0, 0, w, h);

      const diameter = CROP_R * 2;
      const scale = (diameter / Math.min(photoImg.width, photoImg.height)) * crop.zoom;
      const dw = photoImg.width * scale;
      const dh = photoImg.height * scale;
      const dx = cx - crop.focusX * dw;
      const dy = cy - crop.focusY * dh;

      ctx.save();
      ctx.beginPath();
      ctx.arc(cx, cy, CROP_R, 0, Math.PI * 2);
      ctx.closePath();
      ctx.clip();
      ctx.drawImage(photoImg, dx, dy, dw, dh);
      ctx.restore();

      ctx.beginPath();
      ctx.arc(cx, cy, CROP_R, 0, Math.PI * 2);
      ctx.strokeStyle = 'rgba(255, 107, 53, 0.95)';
      ctx.lineWidth = 3;
      ctx.stroke();

      // Dim outside circle
      ctx.save();
      ctx.fillStyle = 'rgba(10, 14, 26, 0.55)';
      ctx.beginPath();
      ctx.rect(0, 0, w, h);
      ctx.arc(cx, cy, CROP_R, 0, Math.PI * 2, true);
      ctx.fill();
      ctx.restore();
    }

    async function loadPhoto(url: string | null) {
      photoImg = null;
      if (!url) {
        cropWrap.hidden = true;
        return;
      }
      const img = new Image();
      await new Promise<void>((resolve, reject) => {
        img.onload = () => resolve();
        img.onerror = () => reject(new Error('photo load failed'));
        img.src = url;
      });
      photoImg = img;
      photoCrop = { focusX: 0.5, focusY: 0.38, zoom: 1 };
      zoomEl.value = '1';
      cropWrap.hidden = false;
      paintCropPreview();
    }

    async function redraw() {
      if (!selectedName) return;
      const token = ++renderToken;
      await drawNameIdentityCard(canvas, {
        name: selectedName,
        photoUrl,
        photoCrop: photoUrl ? photoCrop : null,
        meta: selectedMeta,
      });
      if (token !== renderToken) return;
    }

    speciesEl.addEventListener('change', () => {
      selectedName = '';
      selectedLabel.textContent = '—';
      downloadBtn.disabled = true;
      renderNameButtons();
    });
    listEl.addEventListener('change', () => {
      selectedName = '';
      selectedLabel.textContent = '—';
      downloadBtn.disabled = true;
      renderNameButtons();
    });

    customEl.addEventListener('input', () => {
      const v = customEl.value.trim();
      if (!v) return;
      selectName(v, `Custom · ${speciesEl.value === 'dog' ? 'Dog' : 'Cat'}`);
    });

    photoEl.addEventListener('change', async () => {
      const file = photoEl.files?.[0];
      if (photoUrl) URL.revokeObjectURL(photoUrl);
      photoUrl = file ? URL.createObjectURL(file) : null;
      clearPhotoBtn.hidden = !photoUrl;
      try {
        await loadPhoto(photoUrl);
      } catch {
        photoUrl = null;
        photoImg = null;
        cropWrap.hidden = true;
      }
      void redraw();
    });

    clearPhotoBtn.addEventListener('click', () => {
      if (photoUrl) URL.revokeObjectURL(photoUrl);
      photoUrl = null;
      photoImg = null;
      photoEl.value = '';
      clearPhotoBtn.hidden = true;
      cropWrap.hidden = true;
      void redraw();
    });

    zoomEl.addEventListener('input', () => {
      if (!photoImg) return;
      photoCrop = normalizePhotoCrop(photoImg.width, photoImg.height, {
        ...photoCrop,
        zoom: Number(zoomEl.value) || 1,
      }, CROP_R);
      paintCropPreview();
      void redraw();
    });

    function pointerToCanvas(e: PointerEvent) {
      const rect = cropCanvas.getBoundingClientRect();
      const sx = cropCanvas.width / rect.width;
      const sy = cropCanvas.height / rect.height;
      return { x: (e.clientX - rect.left) * sx, y: (e.clientY - rect.top) * sy };
    }

    cropCanvas.addEventListener('pointerdown', (e) => {
      if (!photoImg) return;
      cropCanvas.setPointerCapture(e.pointerId);
      const p = pointerToCanvas(e);
      drag = { x: p.x, y: p.y, focusX: photoCrop.focusX ?? 0.5, focusY: photoCrop.focusY ?? 0.38 };
    });

    cropCanvas.addEventListener('pointermove', (e) => {
      if (!drag || !photoImg) return;
      const p = pointerToCanvas(e);
      const crop = normalizePhotoCrop(photoImg.width, photoImg.height, photoCrop, CROP_R);
      const diameter = CROP_R * 2;
      const scale = (diameter / Math.min(photoImg.width, photoImg.height)) * crop.zoom;
      const dw = photoImg.width * scale;
      const dh = photoImg.height * scale;
      // Dragging image right → focus moves left
      const next: PhotoCrop = {
        zoom: crop.zoom,
        focusX: drag.focusX - (p.x - drag.x) / dw,
        focusY: drag.focusY - (p.y - drag.y) / dh,
      };
      photoCrop = normalizePhotoCrop(photoImg.width, photoImg.height, next, CROP_R);
      paintCropPreview();
      void redraw();
    });

    function endDrag() {
      drag = null;
    }
    cropCanvas.addEventListener('pointerup', endDrag);
    cropCanvas.addEventListener('pointercancel', endDrag);

    downloadBtn.addEventListener('click', async () => {
      if (!selectedName) return;
      await redraw();
      const safe = selectedName.replace(/[^\w\-]+/g, '_').slice(0, 32);
      downloadCanvasPng(canvas, `hotpicklab-${safe}-name-card.png`);
    });

    const lockedEl = document.getElementById('pnc-locked')!;
    const pickerEl = document.getElementById('pnc-picker')!;
    const lockedNameEl = document.getElementById('pnc-locked-name')!;
    const changeNameBtn = document.getElementById('pnc-change-name')!;
    const photoTitle = document.getElementById('pnc-photo-title')!;
    const previewTitle = document.getElementById('pnc-preview-title')!;
    const leadEl = document.getElementById('pnc-lead')!;

    function setLockedMode(on: boolean) {
      lockedEl.hidden = !on;
      pickerEl.hidden = on;
      if (on) {
        photoTitle.textContent = '1. Photo (optional)';
        previewTitle.textContent = '2. Preview & download';
        leadEl.textContent =
          'Your pick is locked in. Add an optional photo, drag to center the face, then download. Nothing is uploaded.';
      } else {
        photoTitle.textContent = '2. Photo (optional)';
        previewTitle.textContent = '3. Preview & download';
        leadEl.textContent =
          'Pick a name → add a photo and drag to center the face → download. Nothing is uploaded. No payment.';
      }
    }

    changeNameBtn.addEventListener('click', () => {
      setLockedMode(false);
      customEl.value = selectedName;
      customEl.focus();
    });

    // Prefill from Pet Name Lab "Your pick" → Make name card
    const params = new URLSearchParams(window.location.search);
    const qName = (params.get('name') || '').trim();
    const qSpecies = params.get('species');
    const qMeta = params.get('meta') || '';
    if (qSpecies === 'dog' || qSpecies === 'cat') {
      speciesEl.value = qSpecies;
    }
    renderNameButtons();
    if (qName) {
      const meta =
        qMeta ||
        `${capitalize(listEl.value)} · ${speciesEl.value === 'dog' ? 'Dog' : 'Cat'}`;
      selectName(qName, meta);
      lockedNameEl.textContent = qName;
      setLockedMode(true);
    } else {
      setLockedMode(false);
    }
  </script>
</ToolLayout>

<style>
  .pnc {
    width: min(100%, 560px);
    margin: 0 auto;
  }

  .pnc-badge {
    display: inline-block;
    margin: 0 0 0.75rem;
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
    background: #3d2818;
    color: #ffb089;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.03em;
  }

  .pnc-h1 {
    margin: 0 0 0.45rem;
    font-size: clamp(1.5rem, 4vw, 1.95rem);
    line-height: 1.2;
  }

  .pnc-lead,
  .pnc-note,
  .pnc-selected {
    margin: 0 0 1rem;
    color: var(--muted);
    font-size: 0.92rem;
  }

  .pnc-selected strong {
    color: var(--text);
  }

  .pnc-locked-name {
    margin: 0 0 0.45rem;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(2rem, 8vw, 2.6rem);
    font-weight: 700;
    color: #ff6b35;
    line-height: 1.1;
  }

  .pnc-panel {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1rem 1.1rem 1.15rem;
    margin-bottom: 0.9rem;
  }

  .pnc-h2 {
    margin: 0 0 0.75rem;
    font-size: 1.05rem;
  }

  .pnc-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.65rem;
  }

  .pnc-field {
    display: grid;
    gap: 0.3rem;
    margin-bottom: 0.75rem;
    font-size: 0.88rem;
    color: var(--muted);
  }

  .pnc-field select,
  .pnc-field input[type='text'] {
    width: 100%;
    padding: 0.55rem 0.65rem;
    border-radius: 8px;
    border: 1px solid var(--border);
    background: #0f1528;
    color: var(--text);
  }

  .pnc-names {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    max-height: 220px;
    overflow: auto;
    padding: 0.15rem;
  }

  .pnc-name {
    border: 1px solid var(--border);
    background: #0f1528;
    color: var(--text);
    border-radius: 999px;
    padding: 0.35rem 0.7rem;
    font-weight: 600;
    font-size: 0.86rem;
    cursor: pointer;
  }

  .pnc-name.is-on,
  .pnc-name:hover {
    border-color: var(--accent);
  }

  .pnc-preview-wrap {
    border-radius: 14px;
    overflow: hidden;
    border: 1px solid var(--border);
    background: #0a0e1a;
    margin-bottom: 0.85rem;
  }

  #pnc-canvas {
    display: block;
    width: 100%;
    height: auto;
  }

  .pnc-btn {
    width: 100%;
    border: 0;
    cursor: pointer;
    text-align: center;
  }

  .pnc-btn:disabled {
    opacity: 0.45;
    cursor: not-allowed;
  }

  .pnc-btn-ghost {
    margin-top: 0.55rem;
    border: 1px solid var(--border);
    background: transparent;
    color: var(--muted);
    border-radius: 8px;
    padding: 0.45rem 0.8rem;
    font-weight: 600;
    cursor: pointer;
  }

  input[type='file'] {
    color: var(--muted);
    font-size: 0.88rem;
    max-width: 100%;
  }

  .pnc-crop {
    margin-top: 0.85rem;
  }

  #pnc-crop-canvas {
    display: block;
    width: min(100%, 320px);
    height: auto;
    margin: 0 auto;
    border-radius: 16px;
    cursor: grab;
    touch-action: none;
    background: #0a0e1a;
    border: 1px solid var(--border);
  }

  #pnc-crop-canvas:active {
    cursor: grabbing;
  }

  .pnc-crop-hint {
    margin: 0.45rem 0 0.55rem;
    text-align: center;
    color: var(--muted);
    font-size: 0.82rem;
  }

  .pnc-zoom {
    display: grid;
    gap: 0.3rem;
    font-size: 0.85rem;
    color: var(--muted);
    max-width: 320px;
    margin: 0 auto;
  }

  .pnc-zoom input[type='range'] {
    width: 100%;
  }
</style>
