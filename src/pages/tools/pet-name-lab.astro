---
import ToolLayout from '../../layouts/ToolLayout.astro';
import PetNameLabEmbed from '../../components/naming/PetNameLabEmbed.astro';
---

<ToolLayout
  title="Free Pet Name Generator for Dogs & Cats — Scores, Compare & Hot Pick"
  description="Free pet name generator for dogs and cats. Filter by gender and vibe, shortlist scored names, compare 2–5 favorites, and get one Hot Pick. Optional fun vibe cards are entertainment only."
  keywords={[
    'pet name generator',
    'dog name generator',
    'cat name generator',
    'dog names',
    'cat names',
    'pet name ideas',
    'best dog names',
    'best cat names',
    'compare pet names',
    'hot pick',
  ]}
  backHref="/tools"
  backLabel="All labs"
>
  <PetNameLabEmbed showHero species="dog" gender="neutral" vibe="cute" />
  <p class="tool-related">
    Browse lists:
    <a href="/dog-names">dog names</a>
    ·
    <a href="/cat-names">cat names</a>
  </p>
</ToolLayout>
