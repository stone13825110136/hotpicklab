---
import type { Gender, Species, Vibe } from '../../lib/naming/types';

interface Props {
  species?: Species;
  gender?: Gender;
  vibe?: Vibe;
  /** Show the full hero heading inside the lab (tool page). SEO pages usually hide this. */
  showHero?: boolean;
  compact?: boolean;
}

const {
  species = 'dog',
  gender = 'neutral',
  vibe = 'cute',
  showHero = false,
  compact = false,
} = Astro.props;
---

<div
  id="pet-name-lab"
  class:list={['pnl', compact && 'pnl-compact']}
  data-species={species}
  data-gender={gender}
  data-vibe={vibe}
>
  {
    showHero && (
      <header class="pnl-hero">
        <p class="pnl-kicker">Free naming lab</p>
        <h1>Pet Name Lab</h1>
        <p class="pnl-lede">
          Shortlist dog or cat names, compare your favorites, and get one
          <strong>Hot Pick</strong> based on practical score — not a hundred random names.
        </p>
      </header>
    )
  }

  {
    !showHero && (
      <header class="pnl-hero pnl-hero-embed">
        <p class="pnl-kicker">Try the lab</p>
        <h2 class="pnl-embed-title">Compare names &amp; get a Hot Pick</h2>
        <p class="pnl-lede">
          Filters are pre-set for this page. Change them anytime, pick 2–5 names, then compare.
        </p>
      </header>
    )
  }

  <section class="pnl-controls" aria-label="Filters">
    <label>
      Species
      <select id="pnl-species">
        <option value="dog" selected={species === 'dog'}>Dog</option>
        <option value="cat" selected={species === 'cat'}>Cat</option>
      </select>
    </label>
    <label>
      Gender
      <select id="pnl-gender">
        <option value="boy" selected={gender === 'boy'}>Boy</option>
        <option value="girl" selected={gender === 'girl'}>Girl</option>
        <option value="neutral" selected={gender === 'neutral'}>Neutral</option>
      </select>
    </label>
    <label>
      Vibe
      <select id="pnl-vibe">
        <option value="cute" selected={vibe === 'cute'}>Cute</option>
        <option value="strong" selected={vibe === 'strong'}>Strong</option>
        <option value="unique" selected={vibe === 'unique'}>Unique</option>
        <option value="classic" selected={vibe === 'classic'}>Classic</option>
      </select>
    </label>
    <button type="button" class="btn pnl-btn" id="pnl-generate">Generate names</button>
  </section>

  <section id="pnl-output" class="pnl-output" hidden>
    <p class="pnl-score-hint muted">
      Score /100 = how easy to call + popularity + vibe fit. Higher usually means easier everyday
      use. Pick 2–5 names, then compare.
    </p>

    <p id="pnl-empty" class="pnl-empty muted" hidden>
      No names matched. Try another gender or vibe, then tap Generate names.
    </p>

    <div class="pnl-tray pnl-tray-top">
      <div class="pnl-tray-head">
        <h2>Top scores</h2>
        <p id="pnl-count-top" class="muted"></p>
      </div>
      <div id="pnl-candidates-top" class="pnl-grid" role="group" aria-label="Top scored names"></div>
    </div>

    <div class="pnl-tray pnl-tray-mid">
      <div class="pnl-tray-head">
        <h2>More matches</h2>
        <p id="pnl-count-mid" class="muted"></p>
      </div>
      <div id="pnl-candidates-mid" class="pnl-grid" role="group" aria-label="More name matches"></div>
    </div>

    <details id="pnl-tray-low" class="pnl-tray pnl-tray-low">
      <summary>More names <span id="pnl-count-low" class="muted"></span></summary>
      <div id="pnl-candidates-low" class="pnl-grid" role="group" aria-label="Additional names"></div>
    </details>

    <div class="pnl-more-row">
      <button type="button" class="btn pnl-btn pnl-btn-secondary" id="pnl-more" hidden>
        Show more names
      </button>
      <p id="pnl-batch-meta" class="pnl-batch-meta muted" hidden></p>
    </div>

    <div id="pnl-compare-bar" class="pnl-compare-bar" hidden>
      <p><span class="muted">Selected:</span> <span id="pnl-selected"></span></p>
      <button type="button" class="btn pnl-btn" id="pnl-compare-btn" disabled>
        Compare &amp; Hot Pick
      </button>
    </div>
  </section>

  <section id="pnl-results" class="pnl-results" hidden>
    <div class="pnl-hot">
      <p class="pnl-hot-label">Hot Pick</p>
      <h2 id="pnl-hot-name"></h2>
      <p id="pnl-hot-reason" class="pnl-hot-reason"></p>
    </div>
    <div id="pnl-compare-cards" class="pnl-cards"></div>
    <aside class="pnl-ad" aria-label="Sponsored">
      <p class="muted">Sponsored placement</p>
    </aside>
  </section>

  <p class="pnl-disclaimer muted">
    Optional vibe cards are entertainment only — Fun reading · Not a prediction. Name lists build on
    open
    <a href="https://github.com/sindresorhus/dog-names" rel="noopener">dog-names</a>
    and
    <a href="https://github.com/sindresorhus/cat-names" rel="noopener">cat-names</a>
    (MIT). Card text from the
    <a href="https://tarotoo.com/open-data" rel="noopener">Tarotoo open dataset</a>
    (MIT). See <a href="/disclosure">Disclosure</a>.
  </p>
</div>

<script>
  import '../../scripts/pet-name-lab';
</script>

<style>
  .pnl {
    --pnl-bg: #0b1020;
    --pnl-surface: #141b2f;
    --pnl-text: #eef2ff;
    --pnl-muted: #9aa8c7;
    --pnl-accent: #ff6b35;
    --pnl-accent-2: #22d3ee;
    --pnl-border: #24304d;
    --pnl-radius: 12px;

    width: min(100%, 920px);
    margin: 0 auto;
    color: var(--pnl-text);
    background: var(--pnl-bg);
    border: 1px solid var(--pnl-border);
    border-radius: calc(var(--pnl-radius) + 4px);
    padding: 1.25rem 1rem 1.5rem;
  }

  .pnl a {
    color: var(--pnl-accent-2);
  }

  .pnl .muted {
    color: var(--pnl-muted);
  }

  .pnl-btn,
  .pnl .btn {
    display: inline-block;
    padding: 0.55rem 0.9rem;
    border-radius: 8px;
    border: none;
    background: var(--pnl-accent);
    color: #111;
    font-weight: 700;
    font: inherit;
    cursor: pointer;
    text-decoration: none;
  }

  .pnl-btn:disabled,
  .pnl .btn:disabled {
    opacity: 0.45;
    cursor: not-allowed;
  }

  .pnl-btn-secondary {
    background: transparent;
    color: var(--pnl-text);
    border: 1px solid var(--pnl-border);
  }

  .pnl-btn-secondary:hover {
    border-color: var(--pnl-accent-2);
  }

  .pnl-more-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin: 0.75rem 0 0.25rem;
  }

  .pnl-batch-meta {
    margin: 0;
    font-size: 0.82rem;
  }

  .pnl-hero {
    text-align: center;
    margin-bottom: 1.5rem;
  }

  .pnl-hero-embed {
    margin-bottom: 1.1rem;
  }

  .pnl-kicker {
    color: var(--pnl-accent-2);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    margin: 0 0 0.4rem;
  }

  .pnl-hero h1,
  .pnl-embed-title {
    margin: 0 0 0.5rem;
    font-size: clamp(1.35rem, 3.5vw, 1.85rem);
    color: var(--pnl-text);
  }

  .pnl-lede {
    margin: 0 auto;
    max-width: 36rem;
    color: var(--pnl-muted);
  }

  .pnl-controls {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 0.75rem;
    align-items: end;
    padding: 1rem;
    background: var(--pnl-surface);
    border: 1px solid var(--pnl-border);
    border-radius: var(--pnl-radius);
    margin-bottom: 1.25rem;
  }

  .pnl-controls label {
    display: grid;
    gap: 0.35rem;
    font-size: 0.85rem;
    color: var(--pnl-muted);
  }

  .pnl-controls select {
    padding: 0.55rem 0.6rem;
    border-radius: 8px;
    border: 1px solid var(--pnl-border);
    background: #0b1020;
    color: var(--pnl-text);
    font: inherit;
  }

  .pnl-score-hint {
    margin: 0 0 1rem;
    font-size: 0.85rem;
  }

  .pnl-empty {
    margin: 0 0 1rem;
    padding: 0.75rem 1rem;
    border: 1px dashed var(--pnl-border);
    border-radius: var(--pnl-radius);
  }

  .pnl-tray {
    margin-bottom: 1rem;
    padding: 0.85rem 1rem 1rem;
    border: 1px solid var(--pnl-border);
    border-radius: var(--pnl-radius);
    background: var(--pnl-surface);
  }

  .pnl-tray-top {
    border-color: rgba(255, 107, 53, 0.45);
  }

  .pnl-tray-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    margin-bottom: 0.65rem;
  }

  .pnl-tray-head h2 {
    margin: 0;
    font-size: 1rem;
    color: var(--pnl-text);
  }

  .pnl-tray-low summary {
    font-weight: 650;
    color: var(--pnl-muted);
    margin-bottom: 0.65rem;
    cursor: pointer;
  }

  .pnl-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    gap: 0.55rem;
  }

  .pnl-chip {
    display: grid;
    gap: 0.15rem;
    text-align: left;
    padding: 0.65rem 0.7rem;
    border-radius: 10px;
    border: 1px solid var(--pnl-border);
    background: #0b1020;
    color: var(--pnl-text);
    cursor: pointer;
    font: inherit;
  }

  .pnl-chip:hover {
    border-color: var(--pnl-accent-2);
  }

  .pnl-chip.is-on {
    border-color: var(--pnl-accent);
    box-shadow: inset 0 0 0 1px var(--pnl-accent);
  }

  .pnl-chip-name {
    font-weight: 700;
  }

  .pnl-chip-meta {
    font-size: 0.75rem;
    color: var(--pnl-muted);
  }

  .pnl-compare-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
    justify-content: space-between;
    margin-top: 0.5rem;
    padding: 0.85rem 1rem;
    border-radius: var(--pnl-radius);
    border: 1px dashed var(--pnl-border);
    background: rgba(255, 107, 53, 0.06);
  }

  .pnl-results {
    margin-top: 1.75rem;
  }

  .pnl-hot {
    padding: 1.1rem 1.2rem;
    border-radius: var(--pnl-radius);
    background: linear-gradient(135deg, rgba(255, 107, 53, 0.18), rgba(34, 211, 238, 0.1));
    border: 1px solid var(--pnl-accent);
    margin-bottom: 1rem;
  }

  .pnl-hot-label {
    margin: 0;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--pnl-accent);
  }

  .pnl-hot h2 {
    margin: 0.2rem 0 0.4rem;
    font-size: 1.8rem;
    color: var(--pnl-text);
  }

  .pnl-hot-reason {
    margin: 0;
    color: var(--pnl-muted);
  }

  .pnl-cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 0.75rem;
  }

  .pnl-card {
    padding: 0.9rem 1rem;
    border-radius: var(--pnl-radius);
    border: 1px solid var(--pnl-border);
    background: var(--pnl-surface);
  }

  .pnl-card.is-hot {
    border-color: var(--pnl-accent);
  }

  .pnl-card h3 {
    margin: 0;
    color: var(--pnl-text);
  }

  .pnl-score {
    margin: 0.2rem 0 0.5rem;
    color: var(--pnl-muted);
    font-size: 0.85rem;
  }

  .pnl-fun-wrap {
    margin-top: 0.35rem;
  }

  .pnl-fun-teaser {
    margin: 0 0 0.25rem;
    font-size: 0.88rem;
    color: var(--pnl-text);
  }

  .pnl-fun-label {
    display: inline-block;
    margin-right: 0.35rem;
    padding: 0.1rem 0.4rem;
    border-radius: 999px;
    background: rgba(34, 211, 238, 0.15);
    color: var(--pnl-accent-2);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }

  .pnl-fun-details {
    margin-top: 0.15rem;
    font-size: 0.85rem;
  }

  .pnl-fun-details summary {
    color: var(--pnl-accent-2);
    cursor: pointer;
    list-style: none;
  }

  .pnl-fun-details summary::-webkit-details-marker {
    display: none;
  }

  .pnl-fun-details summary::before {
    content: '▸ ';
  }

  .pnl-fun-details[open] summary::before {
    content: '▾ ';
  }

  .pnl-tarot-vibe {
    margin: 0;
    color: var(--pnl-muted);
  }

  .pnl-fun {
    margin: 0.45rem 0 0;
    font-size: 0.75rem;
    color: var(--pnl-muted);
  }

  .pnl-ad {
    margin-top: 1.25rem;
    padding: 1.25rem;
    border: 1px dashed var(--pnl-border);
    border-radius: var(--pnl-radius);
    text-align: center;
  }

  .pnl-disclaimer {
    margin-top: 1.5rem;
    font-size: 0.82rem;
    text-align: center;
  }

  @media (max-width: 640px) {
    .pnl-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
