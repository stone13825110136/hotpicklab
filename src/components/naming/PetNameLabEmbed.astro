---
import dogNames from '../../data/naming/dog-names.json';
import catNames from '../../data/naming/cat-names.json';
import catNamesExtra from '../../data/naming/cat-names-extra.json';
import { breedsForSpecies } from '../../lib/naming/breeds';
import { rankNamesDetailed } from '../../lib/naming/generate';
import type { Gender, NameEntry, Species, Vibe } from '../../lib/naming/types';

interface Props {
  species?: Species;
  gender?: Gender;
  vibe?: Vibe;
  /** A–Z or empty for any */
  letter?: string;
  /** Popular breed id (soft affinity) or empty */
  breedId?: string;
  /** Show the full hero heading inside the lab (tool page). SEO pages usually hide this. */
  showHero?: boolean;
  compact?: boolean;
}

const {
  species = 'dog',
  gender = 'neutral',
  vibe = 'cute',
  letter = '',
  breedId = '',
  showHero = false,
  compact = false,
} = Astro.props;

const letterNorm = /^[A-Za-z]$/.test(letter) ? letter.toUpperCase() : '';
const dogBreeds = breedsForSpecies('dog');
const catBreeds = breedsForSpecies('cat');
const breedOk =
  breedId &&
  [...dogBreeds, ...catBreeds].some((b) => b.id === breedId && b.species === species)
    ? breedId
    : '';

function mergePool(base: NameEntry[], extra: NameEntry[]): NameEntry[] {
  const map = new Map<string, NameEntry>();
  for (const n of base) map.set(n.name.toLowerCase(), n);
  for (const n of extra) {
    const key = n.name.toLowerCase();
    if (!map.has(key)) map.set(key, n);
  }
  return [...map.values()];
}

const pool =
  species === 'dog'
    ? (dogNames as NameEntry[])
    : mergePool(catNames as NameEntry[], catNamesExtra as NameEntry[]);
const rankedDetail = rankNamesDetailed(pool, gender, vibe, {
  letter: letterNorm,
  breedId: breedOk,
});
const ranked = rankedDetail.names;
const initial = ranked.slice(0, 18);
const ssrTop = initial.slice(0, 6);
const ssrMid = initial.slice(6, 14);
const ssrLow = initial.slice(14);
const letters = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'.split('');
---

<div
  id="pet-name-lab"
  class:list={['pnl', compact && 'pnl-compact']}
  data-species={species}
  data-gender={gender}
  data-vibe={vibe}
  data-letter={letterNorm}
  data-breed={breedOk}
>
  {
    showHero && (
      <header class="pnl-hero">
        <p class="pnl-kicker">Free naming lab</p>
        <h1>Pet Name Lab</h1>
        <p class="pnl-lede">
          Shortlist dog or cat names, compare your favorites, and get one
          <strong>Hot Pick</strong> based on practical score — not a hundred random names.
        </p>
        <p class="pnl-steps">
          <strong>How to use:</strong> Tap a name to select it → pick 2–5 →
          <strong>Compare &amp; Hot Pick</strong>. Use <strong>Show more names</strong> for the next
          scored batch.
        </p>
      </header>
    )
  }

  {
    !showHero && (
      <header class="pnl-hero pnl-hero-embed">
        <p class="pnl-kicker">Try the lab</p>
        <h2 class="pnl-embed-title">Compare names &amp; get a Hot Pick</h2>
        <p class="pnl-lede">
          Filters are pre-set for this page. Tap a name to select it, pick 2–5, then
          <strong>Compare &amp; Hot Pick</strong>.
        </p>
      </header>
    )
  }

  <section class="pnl-controls" aria-label="Filters">
    <label>
      Species
      <select id="pnl-species">
        <option value="dog" selected={species === 'dog'}>Dog</option>
        <option value="cat" selected={species === 'cat'}>Cat</option>
      </select>
    </label>
    <label>
      Gender
      <select id="pnl-gender">
        <option value="boy" selected={gender === 'boy'}>Boy</option>
        <option value="girl" selected={gender === 'girl'}>Girl</option>
        <option value="neutral" selected={gender === 'neutral'}>Neutral</option>
      </select>
    </label>
    <label>
      Vibe
      <select id="pnl-vibe">
        <option value="cute" selected={vibe === 'cute'}>Cute — soft &amp; sweet</option>
        <option value="strong" selected={vibe === 'strong'}>Strong — short &amp; bold</option>
        <option value="unique" selected={vibe === 'unique'}>Unique — rare &amp; literary</option>
        <option value="classic" selected={vibe === 'classic'}>Classic — familiar favorites</option>
      </select>
    </label>
    <label>
      Starts with
      <select id="pnl-letter">
        <option value="" selected={!letterNorm}>Any letter</option>
        {
          letters.map((L) => (
            <option value={L} selected={letterNorm === L}>
              {L}
            </option>
          ))
        }
      </select>
    </label>
    <label>
      Breed
      <select id="pnl-breed">
        <option value="">Any popular breed</option>
        <optgroup id="pnl-breed-dog" label="Popular dogs" hidden={species !== 'dog'}>
          {
            dogBreeds.map((b) => (
              <option value={b.id} selected={breedOk === b.id}>
                {b.label}
              </option>
            ))
          }
        </optgroup>
        <optgroup id="pnl-breed-cat" label="Popular cats" hidden={species !== 'cat'}>
          {
            catBreeds.map((b) => (
              <option value={b.id} selected={breedOk === b.id}>
                {b.label}
              </option>
            ))
          }
        </optgroup>
      </select>
    </label>
    <button
      type="button"
      class="btn pnl-btn"
      id="pnl-generate"
      onclick="window.__pnlGenerate && window.__pnlGenerate()"
    >
      Generate names
    </button>
  </section>

  <p id="pnl-script-fail" class="pnl-script-fail" hidden>
    Interactive controls did not load (ad blocker, translate, or slow network). Names below still
    work as a list — disable blockers, turn off page translate, then hard-refresh (Ctrl+F5).
  </p>

  <section id="pnl-output" class="pnl-output">
    <p class="pnl-how">
      <strong>Tap a name card to select it</strong> (2–5 names). Then hit
      <strong>Compare &amp; Hot Pick</strong> below. Need more ideas?
      <strong>Show more names</strong> loads the next batch by score — not a random shuffle.
    </p>
    <p class="pnl-score-hint muted">
      Score /100 = how easy to call + popularity + vibe fit. Each vibe leads with different
      flagship names (Cute soft, Strong bold, Unique rare, Classic familiar). Starts-with prefers
      that letter; breed is a soft preference only (does not change Hot Pick).
    </p>

    <p
      id="pnl-letter-note"
      class="pnl-letter-note"
      hidden={!rankedDetail.meta.letterSoftened}
    >
      {
        rankedDetail.meta.letterSoftened
          ? `Only ${rankedDetail.meta.letterExactCount} name${rankedDetail.meta.letterExactCount === 1 ? '' : 's'} start with ${letterNorm || 'that letter'} in this filter set — those stay on top; more names are filled below.`
          : ''
      }
    </p>

    <p id="pnl-empty" class="pnl-empty muted" hidden>
      No names matched. Try another letter, breed, gender, or vibe, then tap Generate names.
    </p>

    <div class="pnl-tray pnl-tray-top">
      <div class="pnl-tray-head">
        <h2>Top scores</h2>
        <p id="pnl-count-top" class="muted">{ssrTop.length} names</p>
      </div>
      <div id="pnl-candidates-top" class="pnl-grid" role="group" aria-label="Top scored names">
        {
          ssrTop.map((n) => (
            <div class="pnl-chip pnl-chip-static">
              <span class="pnl-chip-name">{n.name}</span>
              <span class="pnl-chip-meta">
                Score {n.practical}/100 · {n.tags.slice(0, 2).join(' · ')}
              </span>
            </div>
          ))
        }
      </div>
    </div>

    <div class="pnl-tray pnl-tray-mid">
      <div class="pnl-tray-head">
        <h2>More matches</h2>
        <p id="pnl-count-mid" class="muted">{ssrMid.length} names</p>
      </div>
      <div id="pnl-candidates-mid" class="pnl-grid" role="group" aria-label="More name matches">
        {
          ssrMid.map((n) => (
            <div class="pnl-chip pnl-chip-static">
              <span class="pnl-chip-name">{n.name}</span>
              <span class="pnl-chip-meta">
                Score {n.practical}/100 · {n.tags.slice(0, 2).join(' · ')}
              </span>
            </div>
          ))
        }
      </div>
    </div>

    <details id="pnl-tray-low" class="pnl-tray pnl-tray-low" hidden={ssrLow.length === 0}>
      <summary>More names <span id="pnl-count-low" class="muted">{ssrLow.length} names</span></summary>
      <div id="pnl-candidates-low" class="pnl-grid" role="group" aria-label="Additional names">
        {
          ssrLow.map((n) => (
            <div class="pnl-chip pnl-chip-static">
              <span class="pnl-chip-name">{n.name}</span>
              <span class="pnl-chip-meta">
                Score {n.practical}/100 · {n.tags.slice(0, 2).join(' · ')}
              </span>
            </div>
          ))
        }
      </div>
    </details>

    <div class="pnl-more-row">
      <button type="button" class="btn pnl-btn pnl-btn-more" id="pnl-more" hidden={ranked.length <= 18}>
        Show more names →
      </button>
      <p id="pnl-batch-meta" class="pnl-batch-meta muted">
        Showing 1–{initial.length} of {ranked.length} (highest scores first)
      </p>
    </div>

    <div id="pnl-compare-bar" class="pnl-compare-bar" hidden>
      <p><span class="muted">Selected:</span> <span id="pnl-selected"></span></p>
      <button type="button" class="btn pnl-btn" id="pnl-compare-btn" disabled>
        Compare &amp; Hot Pick
      </button>
    </div>
  </section>

  <section id="pnl-results" class="pnl-results" hidden>
    <div class="pnl-hot">
      <p class="pnl-hot-label">Hot Pick</p>
      <h2 id="pnl-hot-name"></h2>
      <p id="pnl-hot-reason" class="pnl-hot-reason"></p>
    </div>
    <div id="pnl-compare-cards" class="pnl-cards"></div>
    <aside class="pnl-ad" aria-label="Sponsored">
      <p class="muted">Sponsored placement</p>
    </aside>
  </section>

  <p class="pnl-disclaimer muted">
    Optional vibe cards are entertainment only — Fun reading · Not a prediction. Name lists build on
    open
    <a href="https://github.com/sindresorhus/dog-names" rel="noopener">dog-names</a>
    and
    <a href="https://github.com/sindresorhus/cat-names" rel="noopener">cat-names</a>
    (MIT). Dog breed popularity uses the
    <a href="https://data.cityofnewyork.us/Health/NYC-Dog-Licensing-Dataset/nu7n-tubp" rel="noopener"
      >NYC Dog Licensing</a
    >
    open dataset (soft preference only). Card text from the
    <a href="https://tarotoo.com/open-data" rel="noopener">Tarotoo open dataset</a>
    (MIT). See <a href="/disclosure">Disclosure</a>.
  </p>
</div>

<script is:inline>
  window.__pnlReady = false;
  window.__pnlGenerate = function () {
    var fail = document.getElementById('pnl-script-fail');
    if (fail && !window.__pnlReady) fail.hidden = false;
  };
  setTimeout(function () {
    if (!window.__pnlReady) {
      var fail = document.getElementById('pnl-script-fail');
      if (fail) fail.hidden = false;
    }
  }, 2500);
</script>
<script>
  import '../../scripts/pet-name-lab';
</script>

<style>
  .pnl {
    --pnl-bg: #0b1020;
    --pnl-surface: #141b2f;
    --pnl-text: #eef2ff;
    --pnl-muted: #9aa8c7;
    --pnl-accent: #ff6b35;
    --pnl-accent-2: #22d3ee;
    --pnl-border: #24304d;
    --pnl-radius: 12px;

    width: min(100%, 920px);
    margin: 0 auto;
    color: var(--pnl-text);
    background: var(--pnl-bg);
    border: 1px solid var(--pnl-border);
    border-radius: calc(var(--pnl-radius) + 4px);
    padding: 1.25rem 1rem 1.5rem;
  }

  .pnl a {
    color: var(--pnl-accent-2);
  }

  .pnl .muted {
    color: var(--pnl-muted);
  }

  .pnl-btn,
  .pnl .btn {
    display: inline-block;
    padding: 0.55rem 0.9rem;
    border-radius: 8px;
    border: none;
    background: var(--pnl-accent);
    color: #111;
    font-weight: 700;
    font: inherit;
    cursor: pointer;
    text-decoration: none;
  }

  .pnl-btn:disabled,
  .pnl .btn:disabled {
    opacity: 0.45;
    cursor: not-allowed;
  }

  .pnl-btn-more {
    width: 100%;
    max-width: 28rem;
    padding: 0.75rem 1.1rem;
    font-size: 1rem;
    background: var(--pnl-accent-2);
    color: #0b1020;
    box-shadow: 0 0 0 2px rgba(34, 211, 238, 0.25);
  }

  .pnl-btn-more:hover {
    filter: brightness(1.05);
  }

  .pnl-more-row {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 0.45rem;
    margin: 1rem 0 0.5rem;
    padding: 0.85rem 1rem;
    border: 1px solid rgba(34, 211, 238, 0.45);
    border-radius: var(--pnl-radius);
    background: rgba(34, 211, 238, 0.08);
  }

  .pnl-batch-meta {
    margin: 0;
    font-size: 0.82rem;
  }

  .pnl-steps {
    margin: 0.85rem auto 0;
    max-width: 36rem;
    padding: 0.65rem 0.85rem;
    border-radius: 8px;
    background: rgba(255, 107, 53, 0.1);
    border: 1px solid rgba(255, 107, 53, 0.35);
    color: var(--pnl-text);
    font-size: 0.9rem;
    text-align: left;
  }

  .pnl-how {
    margin: 0 0 0.75rem;
    padding: 0.7rem 0.85rem;
    border-radius: 8px;
    background: rgba(255, 107, 53, 0.12);
    border: 1px solid rgba(255, 107, 53, 0.4);
    color: var(--pnl-text);
    font-size: 0.92rem;
    line-height: 1.45;
  }

  .pnl-script-fail {
    margin: 0 0 1rem;
    padding: 0.75rem 0.9rem;
    border-radius: 8px;
    background: rgba(248, 113, 113, 0.15);
    border: 1px solid rgba(248, 113, 113, 0.55);
    color: #fecaca;
    font-size: 0.9rem;
    line-height: 1.45;
  }

  .pnl-chip-static {
    cursor: default;
  }

  .pnl-chip-static:hover {
    border-color: var(--pnl-border);
  }

  .pnl-hero {
    text-align: center;
    margin-bottom: 1.5rem;
  }

  .pnl-hero-embed {
    margin-bottom: 1.1rem;
  }

  .pnl-kicker {
    color: var(--pnl-accent-2);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    margin: 0 0 0.4rem;
  }

  .pnl-hero h1,
  .pnl-embed-title {
    margin: 0 0 0.5rem;
    font-size: clamp(1.35rem, 3.5vw, 1.85rem);
    color: var(--pnl-text);
  }

  .pnl-lede {
    margin: 0 auto;
    max-width: 36rem;
    color: var(--pnl-muted);
  }

  .pnl-controls {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 0.75rem;
    align-items: end;
    padding: 1rem;
    background: var(--pnl-surface);
    border: 1px solid var(--pnl-border);
    border-radius: var(--pnl-radius);
    margin-bottom: 1.25rem;
  }

  .pnl-controls label {
    display: grid;
    gap: 0.35rem;
    font-size: 0.85rem;
    color: var(--pnl-muted);
  }

  .pnl-controls select {
    padding: 0.55rem 0.6rem;
    border-radius: 8px;
    border: 1px solid var(--pnl-border);
    background: #0b1020;
    color: var(--pnl-text);
    font: inherit;
  }

  .pnl-letter-note {
    margin: 0 0 1rem;
    padding: 0.7rem 0.85rem;
    border-radius: 8px;
    background: rgba(34, 211, 238, 0.1);
    border: 1px solid rgba(34, 211, 238, 0.4);
    color: var(--pnl-text);
    font-size: 0.88rem;
    line-height: 1.45;
  }

  .pnl-score-hint {
    margin: 0 0 1rem;
    font-size: 0.85rem;
  }

  .pnl-empty {
    margin: 0 0 1rem;
    padding: 0.75rem 1rem;
    border: 1px dashed var(--pnl-border);
    border-radius: var(--pnl-radius);
  }

  .pnl-tray {
    margin-bottom: 1rem;
    padding: 0.85rem 1rem 1rem;
    border: 1px solid var(--pnl-border);
    border-radius: var(--pnl-radius);
    background: var(--pnl-surface);
  }

  .pnl-tray-top {
    border-color: rgba(255, 107, 53, 0.45);
  }

  .pnl-tray-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    margin-bottom: 0.65rem;
  }

  .pnl-tray-head h2 {
    margin: 0;
    font-size: 1rem;
    color: var(--pnl-text);
  }

  .pnl-tray-low summary {
    font-weight: 650;
    color: var(--pnl-muted);
    margin-bottom: 0.65rem;
    cursor: pointer;
  }

  .pnl-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    gap: 0.55rem;
  }

  .pnl-chip {
    display: grid;
    gap: 0.15rem;
    text-align: left;
    padding: 0.65rem 0.7rem;
    border-radius: 10px;
    border: 1px solid var(--pnl-border);
    background: #0b1020;
    color: var(--pnl-text);
    cursor: pointer;
    font: inherit;
    min-width: 0;
  }

  .pnl-chip:hover {
    border-color: var(--pnl-accent-2);
  }

  .pnl-chip.is-on {
    border-color: var(--pnl-accent);
    box-shadow: inset 0 0 0 1px var(--pnl-accent);
  }

  .pnl-chip-name {
    font-weight: 700;
  }

  .pnl-chip-meta {
    font-size: 0.75rem;
    color: var(--pnl-muted);
  }

  .pnl-compare-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
    justify-content: space-between;
    margin-top: 0.75rem;
    padding: 0.95rem 1rem;
    border-radius: var(--pnl-radius);
    border: 1px solid rgba(255, 107, 53, 0.55);
    background: rgba(255, 107, 53, 0.12);
  }

  .pnl-results {
    margin-top: 1.75rem;
  }

  .pnl-hot {
    padding: 1.1rem 1.2rem;
    border-radius: var(--pnl-radius);
    background: linear-gradient(135deg, rgba(255, 107, 53, 0.18), rgba(34, 211, 238, 0.1));
    border: 1px solid var(--pnl-accent);
    margin-bottom: 1rem;
  }

  .pnl-hot-label {
    margin: 0;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--pnl-accent);
  }

  .pnl-hot h2 {
    margin: 0.2rem 0 0.4rem;
    font-size: 1.8rem;
    color: var(--pnl-text);
  }

  .pnl-hot-reason {
    margin: 0;
    color: var(--pnl-muted);
  }

  .pnl-cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 0.75rem;
  }

  .pnl-card {
    padding: 0.9rem 1rem;
    border-radius: var(--pnl-radius);
    border: 1px solid var(--pnl-border);
    background: var(--pnl-surface);
  }

  .pnl-card.is-hot {
    border-color: var(--pnl-accent);
  }

  .pnl-card h3 {
    margin: 0;
    color: var(--pnl-text);
  }

  .pnl-score {
    margin: 0.2rem 0 0.5rem;
    color: var(--pnl-muted);
    font-size: 0.85rem;
  }

  .pnl-fun-wrap {
    margin-top: 0.35rem;
  }

  .pnl-fun-teaser {
    margin: 0 0 0.25rem;
    font-size: 0.88rem;
    color: var(--pnl-text);
  }

  .pnl-fun-label {
    display: inline-block;
    margin-right: 0.35rem;
    padding: 0.1rem 0.4rem;
    border-radius: 999px;
    background: rgba(34, 211, 238, 0.15);
    color: var(--pnl-accent-2);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }

  .pnl-fun-details {
    margin-top: 0.15rem;
    font-size: 0.85rem;
  }

  .pnl-fun-details summary {
    color: var(--pnl-accent-2);
    cursor: pointer;
    list-style: none;
  }

  .pnl-fun-details summary::-webkit-details-marker {
    display: none;
  }

  .pnl-fun-details summary::before {
    content: '▸ ';
  }

  .pnl-fun-details[open] summary::before {
    content: '▾ ';
  }

  .pnl-tarot-vibe {
    margin: 0;
    color: var(--pnl-muted);
  }

  .pnl-fun {
    margin: 0.45rem 0 0;
    font-size: 0.75rem;
    color: var(--pnl-muted);
  }

  .pnl-ad {
    margin-top: 1.25rem;
    padding: 1.25rem;
    border: 1px dashed var(--pnl-border);
    border-radius: var(--pnl-radius);
    text-align: center;
  }

  .pnl-disclaimer {
    margin-top: 1.5rem;
    font-size: 0.82rem;
    text-align: center;
  }

  @media (max-width: 640px) {
    .pnl-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
