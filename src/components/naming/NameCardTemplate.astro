---
/**
 * Visual template of the downloadable name Identity Card (HTML/CSS).
 * Matches canvas card voice: Meet → photo? → big name → why → species → URL.
 * Display only — downloads still use src/lib/naming/name-card.ts.
 */
interface Props {
  name?: string;
  blurb?: string;
  species?: 'Dog' | 'Cat' | string;
  photoSrc?: string | null;
  brand?: string;
  class?: string;
}

const {
  name = 'Mochi',
  blurb = 'Cute · easy to call.',
  species = 'Dog',
  photoSrc = null,
  brand = 'HOTPICK LAB',
  class: className = '',
} = Astro.props;

const hasPhoto = Boolean(photoSrc);
---

<figure class:list={['nct', hasPhoto && 'nct--photo', className]} aria-label={`Sample name card for ${name}`}>
  <p class="nct-brand">{brand}</p>
  <p class="nct-meet">Meet</p>
  {
    hasPhoto && photoSrc ? (
      <div class="nct-photo-wrap">
        <img class="nct-photo" src={photoSrc} alt="" width="420" height="420" loading="lazy" decoding="async" />
      </div>
    ) : null
  }
  <p class="nct-name">{name}</p>
  <p class="nct-blurb">{blurb}</p>
  <div class="nct-rule" aria-hidden="true"></div>
  <p class="nct-species">{species}</p>
  <p class="nct-foot">hotpicklab.com · Free name card</p>
</figure>

<style>
  .nct {
    --nct-ink: #1f6f63;
    --nct-soft: #4a5f5a;
    --nct-brand: #2f7a6d;
    --nct-line: rgba(36, 87, 79, 0.22);
    box-sizing: border-box;
    margin: 0;
    width: 100%;
    max-width: 340px;
    aspect-ratio: 4 / 5;
    padding: 1.35rem 1.25rem 1.15rem;
    border-radius: 28px;
    background: linear-gradient(165deg, #d9efe8 0%, #f3efe6 55%, #f7f1e8 100%);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    box-shadow:
      0 18px 40px rgba(18, 40, 36, 0.12),
      0 2px 0 rgba(255, 255, 255, 0.55) inset;
  }

  .nct-brand {
    margin: 0;
    font-family: var(--font-sans, 'IBM Plex Sans', system-ui, sans-serif);
    font-weight: 700;
    font-size: 0.68rem;
    letter-spacing: 0.28em;
    color: var(--nct-brand);
    text-transform: uppercase;
  }

  .nct-meet {
    margin: 0.55rem 0 0;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--nct-soft);
  }

  .nct-photo-wrap {
    margin-top: 0.85rem;
    width: min(46%, 148px);
    aspect-ratio: 1;
    border-radius: 50%;
    overflow: hidden;
    border: 3px solid rgba(31, 111, 99, 0.28);
    flex-shrink: 0;
  }

  .nct-photo {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .nct-name {
    margin: auto 0 0;
    padding-top: 0.75rem;
    font-family: Georgia, 'Times New Roman', serif;
    font-weight: 700;
    font-size: clamp(2.1rem, 8vw, 2.75rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--nct-ink);
  }

  .nct--photo .nct-name {
    margin-top: 0.65rem;
    padding-top: 0;
  }

  .nct-blurb {
    margin: 0.55rem 0 0;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 0.92rem;
    color: var(--nct-soft);
    max-width: 16rem;
  }

  .nct-rule {
    width: 56%;
    height: 1px;
    margin: 1.1rem 0 0.75rem;
    background: var(--nct-line);
  }

  .nct-species {
    margin: 0;
    font-family: var(--font-sans, 'IBM Plex Sans', system-ui, sans-serif);
    font-weight: 600;
    font-size: 0.82rem;
    color: #24574f;
  }

  .nct-foot {
    margin: 0.55rem 0 0;
    font-family: var(--font-sans, 'IBM Plex Sans', system-ui, sans-serif);
    font-weight: 500;
    font-size: 0.72rem;
    color: var(--nct-brand);
  }

  @media (min-width: 860px) {
    .nct {
      max-width: 380px;
    }
  }
</style>
